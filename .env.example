# ---- Required ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=make-up-a-long-random-string
LINK_SECRET=make-up-another-long-random-string

# Test mode: no real card charges, SMS or ID checks. SMS code is always 123456.
# Set to false before launch.
NEXT_PUBLIC_TEST_MODE=true

# ---- Payments and ID checks (Stripe) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Preferred: a Messaging Service using your ACMA-registered "Tyrebiter" sender ID
TWILIO_MESSAGING_SERVICE_SID=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Tyrebiter <hello@tyrebiter.com.au>

# ---- Vehicle lookups on the Sell page ----
# Our own free lookup is always on and needs no settings.
# Optional paid plate lookups (off unless both are set): carregistrationapi (key = username) or autograb (key = API key).
REGO_LOOKUP_PROVIDER=
REGO_LOOKUP_KEY=
# Most paid lookups a day across the whole site (default 300). Only used with a paid provider.
REGO_LOOKUP_DAILY_CAP=

# ---- Shown to buyers ----
NEXT_PUBLIC_SUPPORT_PHONE=1300 000 000
NEXT_PUBLIC_SUPPORT_EMAIL=help@tyrebiter.com.au
NEXT_PUBLIC_BANK_NAME=Tyrebiter Pty Ltd
NEXT_PUBLIC_BANK_BSB=000-000
NEXT_PUBLIC_BANK_ACCOUNT=00000000
NEXT_PUBLIC_PAYID=
NEXT_PUBLIC_LEGAL_NAME=Tyrebiter Pty Ltd
NEXT_PUBLIC_ABN=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_DEALER_LICENCE=

# ---- Phone apps (iOS + Android) ----
# Optional: an Expo access token (expo.dev > Access tokens) raises push sending limits. Pushes work without it.
EXPO_ACCESS_TOKEN=
# Set true to skip sending push notifications (local testing).
PUSH_DISABLED=
# Lets website links open in the app. Apple: your 10-character Team ID (developer.apple.com > Membership).
APPLE_TEAM_ID=
# Android: SHA-256 certificate fingerprints, comma separated. Play Console > Test and release > App integrity >
# App signing (copy both the "App signing key" and the "Upload key" SHA-256).
ANDROID_CERT_SHA256=
# Store links, shown on the website once the apps are live.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# The information machine (all optional)
# Google Search Console: a service account's JSON key (or base64 of it), and the property, e.g. sc-domain:tyrebiter.com.au
GOOGLE_SERVICE_ACCOUNT=
GSC_SITE=
# The key for IndexNow pings to Bing and others (made from LINK_SECRET if empty)
INDEXNOW_KEY=
# Claude writes the weekly briefing's summary paragraph (only business totals are sent)
ANTHROPIC_API_KEY=
INSIGHTS_AI_MODEL=claude-haiku-4-5-20251001

# Site health (Admin → Site health)
# Ask Claude uses ANTHROPIC_API_KEY (above); the model it uses:
HEALTH_AI_MODEL=claude-sonnet-5
# An email address told straight away (not through the database) if the database stops answering
HEALTH_ALERT_EMAIL=
# Claude Code: a fine-grained GitHub token for this repository only (Contents, Issues, Pull requests: read and
# write; Checks, Commit statuses, Deployments: read), and the repository, e.g. mrmcgann/mrmcgann
GITHUB_TOKEN=
GITHUB_REPO=
# GITHUB_BRANCH=main
